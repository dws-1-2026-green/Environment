          "legendFormat": "total",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 18,
      "title": "Deliveries Dispatched (total)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 62, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(subscriptions_deliveries_dispatched_total)",
          "legendFormat": "total",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 19,
      "title": "Processing Outcomes (total)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 62, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "errors" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(subscriptions_events_processed_total)",
          "legendFormat": "success",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(subscriptions_routing_errors_total) or vector(0)",
          "legendFormat": "errors",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 20,
      "title": "DB Query Duration (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 69, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(subscriptions_db_query_duration_seconds_bucket[1m])) by (le, backend)) * 1000",
          "legendFormat": "p50 {{backend}}",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(subscriptions_db_query_duration_seconds_bucket[1m])) by (le, backend)) * 1000",
          "legendFormat": "p90 {{backend}}",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(subscriptions_db_query_duration_seconds_bucket[1m])) by (le, backend)) * 1000",
          "legendFormat": "p95 {{backend}}",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(subscriptions_db_query_duration_seconds_bucket[1m])) by (le, backend)) * 1000",
          "legendFormat": "p99 {{backend}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 30,
      "title": "subscription-service — Resources",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 77, "w": 24, "h": 1 }
    },
    {
      "id": 31,
      "title": "CPU Usage (%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 78, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"subscriptions-worker\"}[1m]) * 100",
          "legendFormat": "worker",
          "datasource": "Prometheus"
        },
        {
          "expr": "rate(process_cpu_seconds_total{job=\"subscriptions-api\"}[1m]) * 100",
          "legendFormat": "api",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 32,
      "title": "Memory",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 78, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"subscriptions-worker\"}",
          "legendFormat": "worker rss",
          "datasource": "Prometheus"
        },
        {
          "expr": "go_memstats_heap_inuse_bytes{job=\"subscriptions-worker\"}",
          "legendFormat": "worker heap",
          "datasource": "Prometheus"
        },
        {
          "expr": "process_resident_memory_bytes{job=\"subscriptions-api\"}",
          "legendFormat": "api rss",
          "datasource": "Prometheus"
        },
        {
          "expr": "go_memstats_heap_inuse_bytes{job=\"subscriptions-api\"}",
          "legendFormat": "api heap",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 33,
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 78, "w": 8, "h": 7 },
