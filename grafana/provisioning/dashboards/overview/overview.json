{
  "title": "Overview",
  "uid": "overview",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "15s", "30s", "1m", "5m"],
    "time_options": ["1m", "10m", "1h", "3h", "1d"]
  },
  "panels": [
    {
      "id": 1,
      "title": "Pipeline Summary",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "title": "Event Flow",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "events received" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "events → routing.requests" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "events processed" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "events failed (kafka)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(event_receiver_events_received_total)",
          "legendFormat": "events received",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(event_receiver_events_published_total{status='success'})",
          "legendFormat": "events → routing.requests",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(subscriptions_events_processed_total)",
          "legendFormat": "events processed",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(event_receiver_events_published_total{status='error'}) or vector(0)",
          "legendFormat": "events failed (kafka)",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 39,
      "title": "Delivery Flow",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "deliveries dispatched" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "deliveries consumed" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "deliveries: success" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "deliveries: exhausted" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(subscriptions_deliveries_dispatched_total)",
          "legendFormat": "deliveries dispatched",
          "datasource": "Prometheus"
        },
        {
          "expr": "delivery_messages_received_total",
          "legendFormat": "deliveries consumed",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(delivery_final_status_total{status='success'})",
          "legendFormat": "deliveries: success",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(delivery_final_status_total{status='exhausted'}) or vector(0)",
          "legendFormat": "deliveries: exhausted",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 38,
      "title": "Pipeline Ratios",
      "description": "Fan-out: среднее число доставок на одно событие (dispatched / events processed). Success rate: доля доставок, завершившихся успехом.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 7 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 2 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fan-out (deliveries / event)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "delivery success rate" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(subscriptions_deliveries_dispatched_total) / sum(subscriptions_events_processed_total)",
          "legendFormat": "fan-out (deliveries / event)",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(delivery_final_status_total{status='success'}) / sum(delivery_messages_received_total)",
          "legendFormat": "delivery success rate",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 3,
      "title": "Events Received",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 7 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(event_receiver_events_received_total[$__range]))",
          "legendFormat": "received",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 4,
      "title": "→ Kafka: routing.requests",
      "description": "EventReceiver → Subscriptions Worker",
      "type": "stat",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 7 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(event_receiver_events_published_total{status='success'}[$__range]))",
          "legendFormat": "published",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 5,
      "title": "Events Processed",
      "type": "stat",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 7 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(subscriptions_events_processed_total[$__range]))",
          "legendFormat": "processed",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 6,
      "title": "→ Kafka: deliveries.to_send",
      "description": "Subscriptions Worker → Delivery Service",
      "type": "stat",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 7 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(subscriptions_deliveries_dispatched_total[$__range]))",
          "legendFormat": "dispatched",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 7,
      "title": "Deliveries Received",
      "type": "stat",
      "gridPos": { "x": 0, "y": 23, "w": 8, "h": 7 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(delivery_messages_received_total[$__range])",
          "legendFormat": "received",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 8,
      "title": "Successfully Delivered",
      "type": "stat",
      "gridPos": { "x": 8, "y": 23, "w": 8, "h": 7 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(delivery_final_status_total{status='success'}[$__range]))",
          "legendFormat": "delivered",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 9,
      "title": "Delivery Errors",
      "type": "stat",
      "gridPos": { "x": 16, "y": 23, "w": 8, "h": 7 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(delivery_final_status_total{status='exhausted'}[$__range])) or vector(0)",
          "legendFormat": "errors",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 40,
      "title": "Kafka Lag: routing.requests",
      "description": "Lag subscriptions-worker — сколько событий ждут маршрутизации. В норме — 0.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "subscriptions-worker" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag{topic=\"routing.requests\"}) by (consumergroup)",
          "legendFormat": "{{consumergroup}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 41,
      "title": "Kafka Lag: deliveries.to_send",
      "description": "Lag delivery-service — сколько доставок ждут отправки. В норме — 0.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "delivery-group" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag{topic=\"deliveries.to_send\"}) by (consumergroup)",
          "legendFormat": "{{consumergroup}}",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 10,
      "title": "event-service",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 37, "w": 24, "h": 1 }
    },
    {
      "id": 11,
      "title": "Events Received (total)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 38, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(event_receiver_events_received_total)",
          "legendFormat": "total",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 12,
      "title": "Events Published to Kafka (total)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 38, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(event_receiver_events_published_total{status='success'})",
          "legendFormat": "success",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(event_receiver_events_published_total{status='error'}) or vector(0)",
          "legendFormat": "error",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 13,
      "title": "HTTP Requests Total (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 38, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(event_receiver_http_requests_total[1m])) by (method, path, status_code) * 60",
          "legendFormat": "{{method}} {{path}} {{status_code}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 14,
      "title": "Latency: POST /sources/{source_name}/events (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 45, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(event_receiver_http_request_duration_seconds_bucket{path='/sources/{source_name}/events'}[1m])) by (le)) * 1000",
          "legendFormat": "p50",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(event_receiver_http_request_duration_seconds_bucket{path='/sources/{source_name}/events'}[1m])) by (le)) * 1000",
          "legendFormat": "p90",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(event_receiver_http_request_duration_seconds_bucket{path='/sources/{source_name}/events'}[1m])) by (le)) * 1000",
          "legendFormat": "p95",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(event_receiver_http_request_duration_seconds_bucket{path='/sources/{source_name}/events'}[1m])) by (le)) * 1000",
          "legendFormat": "p99",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 15,
      "title": "Latency: GET /health (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 45, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(event_receiver_http_request_duration_seconds_bucket{path='/health'}[1m])) by (le)) * 1000",
          "legendFormat": "p50",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(event_receiver_http_request_duration_seconds_bucket{path='/health'}[1m])) by (le)) * 1000",
          "legendFormat": "p90",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(event_receiver_http_request_duration_seconds_bucket{path='/health'}[1m])) by (le)) * 1000",
          "legendFormat": "p95",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(event_receiver_http_request_duration_seconds_bucket{path='/health'}[1m])) by (le)) * 1000",
          "legendFormat": "p99",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 26,
      "title": "event-service — Resources",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 53, "w": 24, "h": 1 }
    },
    {
      "id": 27,
      "title": "CPU Usage (%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 54, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"event-receiver\"}[1m]) * 100",
          "legendFormat": "cpu",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 28,
      "title": "Memory",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 54, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"event-receiver\"}",
          "legendFormat": "rss",
          "datasource": "Prometheus"
        },
        {
          "expr": "go_memstats_heap_inuse_bytes{job=\"event-receiver\"}",
          "legendFormat": "heap",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 29,
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 54, "w": 8, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "go_goroutines{job=\"event-receiver\"}",
          "legendFormat": "goroutines",
          "datasource": "Prometheus"
        }
      ]
    },

    {
      "id": 16,
      "title": "subscription-service",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 61, "w": 24, "h": 1 }
    },
    {
