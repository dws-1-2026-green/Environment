{
  "title": "Overview",
  "uid": "overview",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "event-service",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "title": "Events Received (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(event_receiver_events_received_total[1m])) by (source, event_type) * 60",
          "legendFormat": "{{source}} / {{event_type}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 3,
      "title": "Events Published to Kafka (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(event_receiver_events_published_total{status='success'}[1m])) * 60",
          "legendFormat": "success",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(rate(event_receiver_events_published_total{status='error'}[1m])) * 60",
          "legendFormat": "error",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Request Duration (p99, ms)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(event_receiver_http_request_duration_seconds_bucket[1m])) by (le, path)) * 1000",
          "legendFormat": "p99 {{path}}",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(event_receiver_http_request_duration_seconds_bucket[1m])) by (le, path)) * 1000",
          "legendFormat": "p50 {{path}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Requests Total (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(event_receiver_http_requests_total[1m])) by (method, path, status_code) * 60",
          "legendFormat": "{{method}} {{path}} {{status_code}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 6,
      "title": "subscription-service",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 }
    },
    {
      "id": 7,
      "title": "Events Processed (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(subscriptions_events_processed_total[1m])) by (source, event_type) * 60",
          "legendFormat": "{{source}} / {{event_type}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 8,
      "title": "Deliveries Dispatched (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(subscriptions_deliveries_dispatched_total[1m])) by (source, event_type) * 60",
          "legendFormat": "{{source}} / {{event_type}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 9,
      "title": "No Matches (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(subscriptions_no_matches_total[1m])) by (source, event_type) * 60",
          "legendFormat": "{{source}} / {{event_type}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 10,
      "title": "Routing Errors (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 23, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "rate(subscriptions_routing_errors_total[1m]) * 60",
          "legendFormat": "errors",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 11,
      "title": "DB Query Duration (p99, ms)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 23, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(subscriptions_db_query_duration_seconds_bucket[1m])) by (le, backend)) * 1000",
          "legendFormat": "p99 {{backend}}",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(subscriptions_db_query_duration_seconds_bucket[1m])) by (le, backend)) * 1000",
          "legendFormat": "p50 {{backend}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 12,
      "title": "delivery-service",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 }
    },
    {
      "id": 13,
      "title": "Messages Received (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 31, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "rate(delivery_messages_received_total[1m]) * 60",
          "legendFormat": "received",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 14,
      "title": "Attempt Outcomes (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 31, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(delivery_attempts_total[1m])) by (status) * 60",
          "legendFormat": "{{status}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 15,
      "title": "Final Status (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 31, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(delivery_final_status_total[1m])) by (status) * 60",
          "legendFormat": "{{status}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 16,
      "title": "Attempt Duration (p99, ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 38, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(delivery_attempt_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p99",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(delivery_attempt_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p50",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 17,
      "title": "Retries (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 38, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "rate(delivery_retries_total[1m]) * 60",
          "legendFormat": "retries",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 18,
      "title": "Pipeline: End-to-End Event Flow (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 38, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(event_receiver_events_received_total[1m])) * 60",
          "legendFormat": "received",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(rate(subscriptions_events_processed_total[1m])) * 60",
          "legendFormat": "routed",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(rate(delivery_final_status_total{status='success'}[1m])) * 60",
          "legendFormat": "delivered",
          "datasource": "Prometheus"
        }
      ]
    }
  ]
}
