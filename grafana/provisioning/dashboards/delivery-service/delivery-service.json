{
  "title": "Delivery Service",
  "uid": "delivery-service",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "15s", "30s", "1m", "5m"],
    "time_options": ["1m", "10m", "1h", "3h", "1d"]
  },
  "panels": [
    {
      "id": 1,
      "title": "Messages Received (total)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "delivery_messages_received_total",
          "legendFormat": "received",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 2,
      "title": "Attempt Outcomes (total)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(delivery_attempts_total{status='success'})",
          "legendFormat": "success",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(delivery_attempts_total{status='failure'}) or vector(0)",
          "legendFormat": "failure",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 3,
      "title": "Retries (total)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "retries" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "delivery_retries_total",
          "legendFormat": "retries",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 4,
      "title": "Final Delivery Outcomes (total)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "exhausted" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(delivery_final_status_total{status='success'})",
          "legendFormat": "success",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(delivery_final_status_total{status='exhausted'}) or vector(0)",
          "legendFormat": "exhausted",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pending Deliveries",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "delivery_pending_total",
          "legendFormat": "pending",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 6,
      "title": "Attempt Duration (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(delivery_attempt_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p50",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(delivery_attempt_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p90",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(delivery_attempt_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p95",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(delivery_attempt_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p99",
          "datasource": "Prometheus"
        }
      ]
    }
    ,{
      "id": 7,
      "title": "Resources",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 }
    },
    {
      "id": 8,
      "title": "CPU Usage (%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"delivery-service\"}[1m]) * 100",
          "legendFormat": "cpu",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 9,
      "title": "Memory",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"delivery-service\"}",
          "legendFormat": "rss",
          "datasource": "Prometheus"
        },
        {
          "expr": "go_memstats_heap_inuse_bytes{job=\"delivery-service\"}",
          "legendFormat": "heap",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 10,
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "go_goroutines{job=\"delivery-service\"}",
          "legendFormat": "goroutines",
          "datasource": "Prometheus"
        }
      ]
    }
  ]
}
